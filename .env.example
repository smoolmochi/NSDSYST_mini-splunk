# Copy this file to .env and adjust as needed. All values below are the
# defaults already baked into docker-compose.yml / gateway.py / worker.py --
# you only need a .env file if you want to override something.

# --- RabbitMQ (must match between gateway.py and worker.py) ---
RABBITMQ_USER=rabbituser
RABBITMQ_PASSWORD=rabbit1234
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Gateway ---
GATEWAY_PORT=8080
PURGE_TIMEOUT_SECONDS=15

# --- Mongo router (host-exposed for local debugging with mongosh/Compass) ---
MONGOS_PORT=27017
